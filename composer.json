{
    "name": "ijodkor/api-dastyor",
    "description": "Laravel dastyor, loyihani bir zumda qurishga yordam beradi",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Anvar Zaripboyev",
            "email": "mendasturchiman@gmail.com"
        },
        {
            "name": "Dilmurod Qurbonboyev",
            "email": "dilmurodqurbonboyev11@gmail.com"
        },
        {
            "name": "Azizbek Gulaliyev",
            "email": "azizgulaliyev44@gmail.com"
        },
        {
            "name": "Shuhratjon Abdurasulov",
            "email": "abdurasulovshuhratjon1998@gmail.com"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": "^8.1|^8.2",
        "ijodkor/laravel-api-response": "^1.2|^1.3",
        "illuminate/contracts": "^9.21|^10.0|^11.0",
        "illuminate/queue": "^9.21|^10.0|^11.0",
        "illuminate/support": "^9.21|^10.0|^11.0",
        "livewire/livewire": "^3.5"
    },
    "require-dev": {
        "orchestra/testbench": "^7.0|^8.0|^9.0"
    },
    "autoload": {
        "psr-4": {
            "Ijodkor\\Dastyor\\": "src/"
        },
        "files": [
            "src/Helpers/helper.php"
        ]
    },
    "scripts": {
        "lint": [
            "@php vendor/bin/phpstan analyse"
        ],
        "test": [
            "@php vendor/bin/phpunit"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Ijodkor\\Dastyor\\AssistantServiceProvider"
            ],
            "aliases": {
                "Dastyor": "Ijodkor\\Dastyor\\"
            }
        }
    }
}
